          "stringUnit": {
            "state": "translated",
            "value": "Tony reads when you are busy, never what your events are about, to suggest tasks at moments that fit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tony lit quand tu es occupé, jamais le contenu de tes événements, pour te proposer des tâches aux bons moments."
          }
        }
      }
    }
  },

    "Tony plans around your meetings. He reads when you are busy, never what the events are about." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tony plans around your meetings. He reads when you are busy, never what the events are about."

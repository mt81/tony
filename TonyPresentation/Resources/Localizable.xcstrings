        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tony planifie autour de tes réunions. Il lit quand tu es occupé, jamais le sujet des événements."
          }
        }
      }
    },
    "Tony plans it only on days with this weather. When there’s no forecast, any day works." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tony plans it only on days with this weather. When there’s no forecast, any day works."
